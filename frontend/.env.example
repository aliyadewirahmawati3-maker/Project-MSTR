# Public frontend configuration; VITE_* values are visible in the browser bundle.
# Do not put passwords or private tokens in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AI_SERVICE_URL=http://localhost:8001
# Target per camera; 2 is enabled only when round-trip latency fits 500 ms.
VITE_YOLO_FPS=1
