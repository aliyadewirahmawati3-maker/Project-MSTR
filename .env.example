# ==========================================
# SIGAP MONOREPO GLOBAL ENVIRONMENT EXAMPLE
# ==========================================

# Port Mappings
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
DB_PORT=5432

# PostgreSQL Configuration
DB_HOST=db
DB_DATABASE=sigap_db
DB_USERNAME=sigap_user
DB_PASSWORD=sigap_secret_change_me

# Backend Service
APP_NAME=SIGAP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generated locally by scripts/setup-env.ps1; never commit the real key.
APP_KEY=
COMPOSER_PROCESS_TIMEOUT=1200

# Internal Network URLs (For container-to-container communication)
INTERNAL_BACKEND_URL=http://backend:8000
INTERNAL_AI_SERVICE_URL=http://ai-service:8001
INTERNAL_DB_URL=postgresql://sigap_user:sigap_secret_change_me@db:5432/sigap_db

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AI_BASE_URL=http://localhost:8001

# Local model profile. Keep coco until custom weights have been trained and evaluated.
SIGAP_YOLO_MODEL_PROFILE=coco
SIGAP_YOLO_CONFIDENCE=0.45
SIGAP_YOLO_MIN_INTERVAL_SECONDS=0.5
SIGAP_YOLO_MAX_AGE_SECONDS=2
SIGAP_YOLO_WEIGHTS=/models/yolov13/yolov13n.pt
# Required only for vehicles-v2; copy SHA256 from the reviewed model manifest.
SIGAP_YOLO_WEIGHTS_SHA256=
