# ==========================================
# SIGAP BACKEND (LARAVEL) ENVIRONMENT
# ==========================================

APP_NAME=SIGAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# PostgreSQL Connection
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sigap_db
DB_USERNAME=sigap_user
DB_PASSWORD=sigap_secret_change_me

# Cache and Sessions
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# AI Service Endpoint
AI_SERVICE_URL=http://ai-service:8001

# System Operational Simulator Settings
DEFAULT_ATCS_MODE=ATCS_NORMAL
TRANSITION_YELLOW_SECONDS=3
TRANSITION_ALL_RED_SECONDS=2

