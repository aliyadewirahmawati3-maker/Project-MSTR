APP_ENV=development
HOST=0.0.0.0
PORT=8001

# Laravel Backend API Target URL
LARAVEL_API_URL=http://backend:8000/api

# Target Intersection Code
INTERSECTION_CODE=BDG-IBR-ADJ-01

# Demo threshold; consumed by the existing detector environment setting.
SIGAP_YOLO_CONFIDENCE=0.45
SIGAP_YOLO_MIN_INTERVAL_SECONDS=0.5
SIGAP_YOLO_MAX_AGE_SECONDS=2
